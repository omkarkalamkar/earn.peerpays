# ---- PeerPays :: PRODUCTION env ----
# Copy to `.env` on the server and fill in real values.

PORT=5050

# The public site origin (used for CORS + Socket.IO).
CLIENT_URL=https://app.yourdomain.com

# PERSISTENT DATABASE - required in production.
# MongoDB Atlas (recommended): mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/mobile_booking?retryWrites=true&w=majority
# On-box MongoDB alternative:   mongodb://127.0.0.1:27017/mobile_booking
MONGO_URI=

# Auth - generate a long random value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Card encryption - 64 hex chars (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if this changes, previously saved cards can no longer be decrypted.
CARD_ENC_KEY=

# Seed admin (created on first boot if missing). CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_NAME=Administrator

# Web Push (VAPID) - generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
